{
  "name": "@trading-journal/backend-services",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/*": "./src/auth/*.ts",
    "./user": "./src/user/index.ts",
    "./user/*": "./src/user/*.ts",
    "./trade": "./src/trade/index.ts",
    "./trade/*": "./src/trade/*.ts",
    "./analytics": "./src/analytics/index.ts",
    "./analytics/*": "./src/analytics/*.ts",
    "./backup": "./src/backup/index.ts",
    "./backup/*": "./src/backup/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trading-journal/backend-data": "workspace:*",
    "@trading-journal/backend-errors": "workspace:*",
    "@trading-journal/shared": "workspace:*",
    "jose": "6.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "6.0.3"
  }
}